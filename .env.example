# Local MySQL settings consumed by Spring Boot. Copy into your terminal's
# environment; Spring Boot does not automatically load this example file.
DB_URL=jdbc:mysql://localhost:3306/dvc?createDatabaseIfNotExist=true&useSSL=false&allowPublicKeyRetrieval=true&serverTimezone=UTC
DB_USERNAME=root
DB_PASSWORD=replace_with_your_local_password

# Demo-only seed credentials (spring.profiles.default=demo).
DVC_DEMO_ADMIN_EMAIL=admin@gmail.com
DVC_DEMO_ADMIN_PASSWORD=Admin@12345
DVC_DEMO_VOLUNTEER_EMAIL=volunteer@gmail.com
DVC_DEMO_VOLUNTEER_PASSWORD=Volunteer@12345
DVC_DEMO_USER_EMAIL=user@gmail.com
DVC_DEMO_USER_PASSWORD=User@12345

# Vite reads the equivalent setting from frontend/.env.local.
VITE_API_BASE_URL=http://localhost:8081/api
